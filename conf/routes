# An example controller showing a sample home page


# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)

# Minesweeper-Web-Routen
# Game JSON API (Minesweeper SPA-style)
GET     /game/homepage           controllers.GameJsonController.gameHomepage()
GET     /game/gui                controllers.GameJsonController.gameGui()
GET     /game/getGameBoard       controllers.GameJsonController.getGameBoard()
POST    /game/setDiff            controllers.GameJsonController.setDifficulty()
POST    /game/uncover            controllers.GameJsonController.uncover()
POST    /game/undo               controllers.GameJsonController.undo()
POST    /game/restart            controllers.GameJsonController.restart()
GET     /game/getBombMatrix      controllers.GameJsonController.getBombMatrix()
POST    /game/save               controllers.GameJsonController.saveGame()
POST    /game/load               controllers.GameJsonController.loadGame()
GET     /game/list              controllers.GameJsonController.getGamesList()


